#!/bin/sh
# ============================================================================
#  Instalador do Computer Optimization 2.0 para Linux (autoextraivel)
#  Uso:  sh Instalador-ComputerOptimization-Linux.run [opcoes]
#    -y, --silencioso        nao pergunta nada (aceita atalho e inicializacao)
#    --sem-atalho            nao cria atalho na area de trabalho
#    --sem-inicializacao     nao inicia junto com a sessao
#    --instalar-dependencias instala python3 e tkinter se faltarem (pede senha)
#    --desinstalar           remove o programa
#    --verificar             so confere a integridade do instalador
#    -h, --ajuda             mostra esta ajuda
#  Instala apenas na sua conta (nao precisa de root).
# ============================================================================
APP_NAME="Computer Optimization"
APP_VER="2.0"
SLUG="computer-optimization"
PAYLOAD_SHA256="f2ea5cce2ca9de9dd2809dc86587a7fd0e9697a62219c978f0a5b5cfc0faf9d2"

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DEST="$DATA_HOME/$SLUG"
BIN_DIR="$HOME/.local/bin"
APPS_DIR="$DATA_HOME/applications"
ICON_DIR="$DATA_HOME/icons/hicolor/256x256/apps"
AUTOSTART_DIR="$CONFIG_HOME/autostart"

ASSUME_YES=0; WANT_DESK=1; WANT_AUTO=1; INSTALL_DEPS=0; MODE=install

if [ -t 1 ]; then B="$(printf '\033[1m')"; G="$(printf '\033[32m')"; R="$(printf '\033[31m')"; Y="$(printf '\033[33m')"; C="$(printf '\033[36m')"; Z="$(printf '\033[0m')"; else B=""; G=""; R=""; Y=""; C=""; Z=""; fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%sâœ”%s %s\n' "$G" "$Z" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$Z" "$*"; }
die()  { printf '%sâœ˜ %s%s\n' "$R" "$*" "$Z" >&2; exit 1; }

for arg in "$@"; do
  case "$arg" in
    -y|--silencioso) ASSUME_YES=1 ;;
    --sem-atalho) WANT_DESK=0 ;;
    --sem-inicializacao) WANT_AUTO=0 ;;
    --instalar-dependencias) INSTALL_DEPS=1 ;;
    --desinstalar) MODE=uninstall ;;
    --verificar) MODE=verify ;;
    -h|--ajuda|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "Opcao desconhecida: $arg (use --ajuda)" ;;
  esac
done

[ -f "$0" ] || die "Execute este instalador como arquivo:  sh Instalador-ComputerOptimization-Linux.run"
[ "$(id -u)" -eq 0 ] && warn "Voce esta rodando como root: o programa sera instalado para o usuario root."

ask() { # ask "pergunta" S|N  -> retorna 0 para sim
  if [ "$ASSUME_YES" -eq 1 ] || [ ! -t 0 ]; then [ "$2" = "S" ]; return; fi
  if [ "$2" = "S" ]; then hint="[S/n]"; else hint="[s/N]"; fi
  printf '%s %s ' "$1" "$hint"; read -r ans
  case "$ans" in s|S|y|Y|sim|Sim) return 0 ;; n|N|nao|Nao|nÃ£o) return 1 ;; *) [ "$2" = "S" ] ;; esac
}

stop_running() { pkill -f "$SLUG/computer_optimization.py" 2>/dev/null || true; }

remove_entries() {
  rm -f "$BIN_DIR/$SLUG" "$APPS_DIR/$SLUG.desktop" "$AUTOSTART_DIR/$SLUG.desktop" "$ICON_DIR/$SLUG.png"
  for d in "$(xdg-user-dir DESKTOP 2>/dev/null)" "$HOME/Desktop" "$HOME/Ãrea de Trabalho" "$HOME/Ãrea de trabalho" "$HOME/Escritorio"; do
    [ -n "$d" ] && rm -f "$d/$SLUG.desktop" "$d/$APP_NAME.desktop" 2>/dev/null
  done
}

refresh_caches() {
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$APPS_DIR" >/dev/null 2>&1
  command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f -t "$DATA_HOME/icons/hicolor" >/dev/null 2>&1
  return 0
}

payload_sha() {
  ARCH_LINE=$(awk '/^__ARCHIVE_BELOW__$/ { print NR + 1; exit }' "$0")
  [ -n "$ARCH_LINE" ] || die "Instalador corrompido (marcador nao encontrado)."
  if command -v sha256sum >/dev/null 2>&1; then tail -n +"$ARCH_LINE" "$0" | sha256sum | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then tail -n +"$ARCH_LINE" "$0" | shasum -a 256 | cut -d' ' -f1
  elif command -v openssl >/dev/null 2>&1; then tail -n +"$ARCH_LINE" "$0" | openssl dgst -sha256 | sed 's/.*= //'
  else echo ""; fi
}

verify() {
  got="$(payload_sha)"
  if [ -z "$got" ]; then warn "Nao foi possivel verificar a integridade (sha256sum ausente)."; return 0; fi
  [ "$got" = "$PAYLOAD_SHA256" ] || die "Falha na verificacao de integridade: o instalador foi alterado ou esta corrompido."
  ok "Integridade verificada (SHA-256 confere)."
}

# --------------------------------------------------------------- desinstalar
if [ "$MODE" = "uninstall" ]; then
  say "${B}Removendo $APP_NAME...${Z}"
  stop_running; remove_entries; rm -rf "$DEST"; refresh_caches
  if [ -d "$CONFIG_HOME/$SLUG" ] && ask "Remover tambem as configuracoes salvas?" N; then rm -rf "$CONFIG_HOME/$SLUG"; fi
  ok "$APP_NAME foi removido."; exit 0
fi
if [ "$MODE" = "verify" ]; then verify; exit 0; fi

say ""
say "${B}${C}$APP_NAME $APP_VER${Z} â€” instalador para Linux"
say "----------------------------------------------"

verify

# --------------------------------------------------------------- dependencias
have_tk() { command -v python3 >/dev/null 2>&1 && python3 -c 'import sys, tkinter; sys.exit(0 if sys.version_info >= (3, 6) else 1)' >/dev/null 2>&1; }

detect_pm() {
  if command -v apt-get >/dev/null 2>&1; then PM=apt; PM_CMD="apt-get install -y python3 python3-tk"
  elif command -v dnf >/dev/null 2>&1; then PM=dnf; PM_CMD="dnf install -y python3 python3-tkinter"
  elif command -v pacman >/dev/null 2>&1; then PM=pacman; PM_CMD="pacman -S --noconfirm python tk"
  elif command -v zypper >/dev/null 2>&1; then PM=zypper; PM_CMD="zypper install -y python3 python3-tk"
  elif command -v apk >/dev/null 2>&1; then PM=apk; PM_CMD="apk add python3 py3-tkinter"
  else PM=""; PM_CMD=""; fi
}

if ! have_tk; then
  warn "Faltam dependencias: Python 3 (>= 3.6) com tkinter."
  detect_pm
  if [ -n "$PM" ]; then
    say "  Comando para instalar:  sudo $PM_CMD"
    if [ "$INSTALL_DEPS" -eq 1 ] || ask "Instalar agora (pede a senha de administrador)?" S; then
      if [ "$(id -u)" -eq 0 ]; then sh -c "$PM_CMD"
      elif command -v sudo >/dev/null 2>&1 && [ -t 0 ]; then sudo sh -c "$PM_CMD"
      elif command -v pkexec >/dev/null 2>&1; then pkexec sh -c "$PM_CMD"
      else warn "sudo/pkexec indisponivel. Rode o comando acima e execute o instalador de novo."; fi
    fi
  else
    say "  Instale o Python 3 e o modulo tkinter da sua distribuicao e execute o instalador de novo."
  fi
  have_tk || die "Dependencias ainda ausentes. Instale python3 + tkinter e tente novamente."
  ok "Dependencias instaladas."
else
  ok "Python $(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])') com tkinter encontrado."
fi

# --------------------------------------------------------------- extrair e copiar
STAGE="$(mktemp -d 2>/dev/null || echo "/tmp/co_install_$$")"; mkdir -p "$STAGE"
trap 'rm -rf "$STAGE"' EXIT INT TERM
ARCH_LINE=$(awk '/^__ARCHIVE_BELOW__$/ { print NR + 1; exit }' "$0")
tail -n +"$ARCH_LINE" "$0" | tar xzf - -C "$STAGE" || die "Falha ao extrair os arquivos."
[ -f "$STAGE/$SLUG/computer_optimization.py" ] || die "Pacote incompleto."

stop_running
rm -rf "$DEST"; mkdir -p "$DATA_HOME" "$BIN_DIR" "$APPS_DIR" "$ICON_DIR"
cp -R "$STAGE/$SLUG" "$DEST"
chmod 755 "$DEST/computer_optimization.py" "$DEST/desinstalar.sh"
ok "Arquivos instalados em $DEST"

cp "$DEST/assets/icon.png" "$ICON_DIR/$SLUG.png"
cat > "$BIN_DIR/$SLUG" <<EOF
#!/bin/sh
LOG_DIR="\${XDG_CACHE_HOME:-\$HOME/.cache}/$SLUG"; mkdir -p "\$LOG_DIR" 2>/dev/null
exec python3 "$DEST/computer_optimization.py" "\$@" 2>"\$LOG_DIR/last-run.log"
EOF
chmod 755 "$BIN_DIR/$SLUG"

make_desktop() {
  cat > "$1" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=$APP_NAME
GenericName=Monitor e otimizador do PC
Comment=Monitora CPU, memoria, disco e rede e otimiza o sistema
Exec=$BIN_DIR/$SLUG
Icon=$ICON_DIR/$SLUG.png
Terminal=false
Categories=System;Monitor;Utility;
Keywords=desempenho;monitor;cpu;memoria;limpeza;otimizar;
StartupWMClass=Computer-optimization
Actions=Uninstall;

[Desktop Action Uninstall]
Name=Desinstalar
Exec=sh "$DEST/desinstalar.sh"
EOF
  chmod 755 "$1"
}
make_desktop "$APPS_DIR/$SLUG.desktop"
ok "Atalho criado no menu de aplicativos."

if [ "$WANT_DESK" -eq 1 ] && ask "Criar atalho na area de trabalho?" S; then
  DESK="$(xdg-user-dir DESKTOP 2>/dev/null)"; [ -d "$DESK" ] || DESK="$HOME/Desktop"
  if [ -d "$DESK" ]; then
    make_desktop "$DESK/$SLUG.desktop"
    command -v gio >/dev/null 2>&1 && gio set "$DESK/$SLUG.desktop" metadata::trusted true >/dev/null 2>&1
    ok "Atalho criado na area de trabalho ($DESK)."
  else warn "Pasta da area de trabalho nao encontrada; atalho nao criado."; fi
fi

if [ "$WANT_AUTO" -eq 1 ] && ask "Iniciar o $APP_NAME junto com a sessao?" S; then
  mkdir -p "$AUTOSTART_DIR"; make_desktop "$AUTOSTART_DIR/$SLUG.desktop"
  ok "Inicializacao automatica ativada."
fi
refresh_caches

case ":$PATH:" in *":$BIN_DIR:"*) ;; *) warn "$BIN_DIR nao esta no PATH. Use o menu de aplicativos ou rode: $BIN_DIR/$SLUG" ;; esac

say ""
ok "Instalacao concluida!  Abra pelo menu de aplicativos ou rode:  ${B}$SLUG${Z}"
say "   Para remover:  sh $DEST/desinstalar.sh"
if ask "Abrir o $APP_NAME agora?" S; then
  LOG="${XDG_CACHE_HOME:-$HOME/.cache}/$SLUG/last-run.log"
  ( nohup "$BIN_DIR/$SLUG" >/dev/null 2>&1 & ) 2>/dev/null
  sleep 3
  if ! pgrep -f "$SLUG/computer_optimization.py" >/dev/null 2>&1; then
    warn "O programa fechou logo depois de abrir. Motivo:"
    if [ -s "$LOG" ]; then sed 's/^/    /' "$LOG"; else say "    (sem mensagem de erro; log em $LOG)"; fi
    say "  Para ver de novo, rode:  $BIN_DIR/$SLUG"
  fi
fi
exit 0
__ARCHIVE_BELOW__
